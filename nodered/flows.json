      ]
    ]
  },
  {
    "id": "split",
    "type": "function",
    "z": "flow_main",
    "name": "split reading",
    "func": "const d = msg.payload || {};\nconst onOff = (v) => (v ? 'ON' : 'off');\nconst temp = d.t_tank === null || d.t_tank === undefined ? null : d.t_tank;\nreturn [\n  { payload: d.score },\n  { payload: d.tds },\n  { payload: d.turb },\n  temp === null ? null : { payload: temp },\n  { payload: d.state },\n  { payload: onOff(d.drain) },\n  { payload: onOff(d.fill) },\n  { payload: d.fault || 'none' },\n  { payload: d.auto === 1 },\n  { topic: 'TDS (ppm)', payload: d.tds },\n  { topic: 'Score', payload: d.score },\n];",
    "outputs": 11,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 160,
    "wires": [
      [
        "g_score"
      ],
      [
        "g_tds"
      ],
      [
        "g_turb"
      ],
      [
        "g_temp"
      ],
      [
        "t_state"
      ],
      [
        "t_drain"
      ],
      [
        "t_fill"
      ],
      [
        "t_fault"
      ],
      [
        "sw_auto"
      ],
      [
        "ch_tds"
      ],
      [
        "ch_score"
      ]
    ]
  },
