    {"type":"text","id":"l1","x":306,"y":186,"width":40,"height":23,"text":"1 s","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#3b82f6","roughness":0},
    {"type":"text","id":"l4","x":686,"y":186,"width":40,"height":23,"text":"4 s","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#3b82f6","roughness":0},
    {"type":"text","id":"l5","x":1066,"y":186,"width":40,"height":23,"text":"5 s","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#3b82f6","roughness":0},
    {"type":"text","id":"t0","x":0,"y":240,"width":280,"height":36,"text":"TDS power on (GPIO 13)\nstart temperature reading","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","roughness":0},
    {"type":"text","id":"t1","x":320,"y":240,"width":300,"height":36,"text":"read temperature + TDS\nTDS power off","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","roughness":0},
    {"type":"text","id":"t4","x":700,"y":240,"width":300,"height":36,"text":"read turbidity\nscore 0–100 · run rules","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","roughness":0},
    {"type":"text","id":"t5","x":1080,"y":240,"width":300,"height":36,"text":"publish /data\nupdate the OLED","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","roughness":0},
    {"type":"arrow","id":"loop","x":1080,"y":180,"width":1080,"height":12,"strokeColor":"#3b82f6","strokeWidth":2,"strokeStyle":"dashed","roughness":0,"points":[[0,0],[0,-16],[-1080,-16],[-1080,-2]],"endArrowhead":"arrow"},
    {"type":"text","id":"loop_l","x":470,"y":140,"width":200,"height":18,"text":"repeat forever","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#3b82f6","roughness":0},

    {"type":"text","id":"h_b","x":0,"y":320,"width":600,"height":25,"text":"B  automatic water change (rule R1)","fontSize":20,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","roughness":0},

    {"type":"ellipse","id":"start","x":0,"y":370,"width":210,"height":100,"strokeColor":"#c2410c","backgroundColor":"#fed7aa","fillStyle":"solid","strokeWidth":2,"roughness":0,"boundElements":[{"id":"start_t","type":"text"},{"id":"a1","type":"arrow"}]},
    {"type":"text","id":"start_t","x":52,"y":400,"width":106,"height":40,"text":"score < 60\nthree times","fontSize":16,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","roughness":0,"containerId":"start"},
    {"type":"text","id":"pct","x":0,"y":490,"width":220,"height":54,"text":"score < 40 → 30 %\nscore < 50 → 20 %\notherwise  → 10 %","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","roughness":0},

    {"type":"diamond","id":"q1","x":260,"y":360,"width":210,"height":120,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"roughness":0,"boundElements":[{"id":"q1_t","type":"text"},{"id":"a1","type":"arrow"},{"id":"a2","type":"arrow"},{"id":"a_no","type":"arrow"}]},
    {"type":"text","id":"q1_t","x":314,"y":402,"width":102,"height":36,"text":"auto on and\nno cooldown?","fontSize":14,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","roughness":0,"containerId":"q1"},
    {"type":"diamond","id":"q2","x":520,"y":360,"width":220,"height":120,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"roughness":0,"boundElements":[{"id":"q2_t","type":"text"},{"id":"a2","type":"arrow"},{"id":"a3","type":"arrow"},{"id":"a_wait","type":"arrow"}]},
    {"type":"text","id":"q2_t","x":563,"y":402,"width":134,"height":36,"text":"tank − reservoir\n> 2 °C ?","fontSize":14,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","roughness":0,"containerId":"q2"},

    {"type":"rectangle","id":"drain","x":790,"y":375,"width":250,"height":90,"strokeColor":"#1e3a5f","backgroundColor":"#3b82f6","fillStyle":"solid","strokeWidth":2,"roughness":0,"roundness":{"type":3},"boundElements":[{"id":"drain_t","type":"text"},{"id":"a3","type":"arrow"},{"id":"a4","type":"arrow"},{"id":"w1_a","type":"arrow"}]},
    {"type":"text","id":"drain_t","x":852,"y":400,"width":126,"height":40,"text":"drain until\ntarget volume","fontSize":16,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#ffffff","roughness":0,"containerId":"drain"},
    {"type":"rectangle","id":"refill","x":1080,"y":375,"width":230,"height":90,"strokeColor":"#1e3a5f","backgroundColor":"#3b82f6","fillStyle":"solid","strokeWidth":2,"roughness":0,"roundness":{"type":3},"boundElements":[{"id":"refill_t","type":"text"},{"id":"a4","type":"arrow"},{"id":"a5","type":"arrow"},{"id":"w2_a","type":"arrow"}]},
    {"type":"text","id":"refill_t","x":1108,"y":400,"width":174,"height":40,"text":"wait 3 s, then\nrefill same volume","fontSize":16,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#ffffff","roughness":0,"containerId":"refill"},
    {"type":"ellipse","id":"done","x":1350,"y":370,"width":210,"height":100,"strokeColor":"#047857","backgroundColor":"#a7f3d0","fillStyle":"solid","strokeWidth":2,"roughness":0,"boundElements":[{"id":"done_t","type":"text"},{"id":"a5","type":"arrow"}]},
    {"type":"text","id":"done_t","x":1383,"y":400,"width":144,"height":40,"text":"idle\n30 min cooldown","fontSize":16,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","roughness":0,"containerId":"done"},

