    {"type":"text","id":"no_l","x":300,"y":532,"width":200,"height":36,"text":"no → keep\nmonitoring","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","roughness":0},

