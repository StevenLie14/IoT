    {"type":"text","id":"title","x":0,"y":0,"width":600,"height":35,"text":"IoT Project · firmware workflow","fontSize":28,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","roughness":0},
    {"type":"text","id":"subtitle","x":0,"y":44,"width":900,"height":23,"text":"what the ESP32 does every 5 seconds, and how a water change runs","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","roughness":0},

    {"type":"text","id":"h_a","x":0,"y":104,"width":400,"height":25,"text":"A  sensor cycle","fontSize":20,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","roughness":0},
