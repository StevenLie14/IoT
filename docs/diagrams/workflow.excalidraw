    {"type":"text","id":"wait_l","x":640,"y":488,"width":40,"height":18,"text":"yes","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#dc2626","roughness":0},
    {"type":"rectangle","id":"wait","x":530,"y":528,"width":200,"height":60,"strokeColor":"#dc2626","backgroundColor":"#fee2e2","fillStyle":"solid","strokeWidth":2,"roughness":0,"roundness":{"type":3},"boundElements":[{"id":"wait_t","type":"text"},{"id":"a_wait","type":"arrow"}]},
    {"type":"text","id":"wait_t","x":553,"y":540,"width":154,"height":36,"text":"wait 5 min,\nthen check again","fontSize":14,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","roughness":0,"containerId":"wait"},

    {"type":"text","id":"vol","x":790,"y":480,"width":220,"height":54,"text":"7000 ml × 20 %\n= 1400 ml drained\n≈ 89 s at 15.8 ml/s","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","roughness":0},

    {"type":"text","id":"h_c","x":0,"y":640,"width":700,"height":25,"text":"C  safety checks on every loop pass","fontSize":20,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","roughness":0},
    {"type":"text","id":"c_note","x":0,"y":676,"width":460,"height":36,"text":"they can stop the pumps at any point\nof the water change above","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","roughness":0},
