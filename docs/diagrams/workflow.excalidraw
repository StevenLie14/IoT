    {"type":"text","id":"w1_t","x":831,"y":712,"width":168,"height":36,"text":"pump on > 3 min\n→ fault, pumps lock","fontSize":14,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","roughness":0,"containerId":"w1"},
    {"type":"rectangle","id":"w2","x":1080,"y":700,"width":230,"height":60,"strokeColor":"#dc2626","backgroundColor":"#fee2e2","fillStyle":"solid","strokeWidth":2,"roughness":0,"roundness":{"type":3},"boundElements":[{"id":"w2_t","type":"text"},{"id":"w2_a","type":"arrow"}]},
    {"type":"text","id":"w2_t","x":1119,"y":712,"width":152,"height":36,"text":"stop or reset\nfrom dashboard","fontSize":14,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","roughness":0,"containerId":"w2"},
